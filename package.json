{
  "name": "ctxcap",
  "version": "1.3.0",
  "description": "Offline token-budget linter for agent context files — measures CLAUDE.md/AGENTS.md, finds dead references, returns a ranked plan.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "ctxcap": "src/index.js",
    "ctxcap-mcp": "mcp/server.js"
  },
  "files": [
    "src",
    "mcp",
    "schema",
    "scripts",
    "examples",
    "action.yml",
    "llms.txt",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "mcp": "node mcp/server.js"
  },
  "dependencies": {
    "fast-glob": "3.3.2",
    "gpt-tokenizer": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naeha-S/ctxcap.git"
  },
  "bugs": {
    "url": "https://github.com/Naeha-S/ctxcap/issues"
  },
  "homepage": "https://github.com/Naeha-S/ctxcap#readme",
  "author": "Naeha S",
  "keywords": [
    "claude-code",
    "cursor",
    "agents",
    "context",
    "ctxcap",
    "token-budget",
    "context-engineering",
    "prompt-engineering",
    "linter",
    "mcp",
    "sarif",
    "github-action"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
