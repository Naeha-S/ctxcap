{
  "name": "ctxcap",
  "version": "1.6.0",
  "description": "Diagnose repository context for coding agents: rank instruction and skill costs, find stale references, flag risky content, and inventory MCP servers.",
  "type": "module",
  "bin": {
    "ctxcap": "src/index.js",
    "ctxcap-mcp": "mcp/server.js"
  },
  "files": [
    "data",
    "src",
    "mcp",
    "schema",
    "scripts/annotate.mjs",
    "scripts/comment.mjs",
    "examples",
    "!examples/**/.ctxcap",
    "action.yml",
    "llms.txt",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/run.mjs",
    "mcp": "node mcp/server.js",
    "leaderboard": "node scripts/leaderboard.mjs",
    "leaderboard:page": "node scripts/leaderboard-page.mjs",
    "index:data": "node scripts/index-data.mjs",
    "mcp:index": "node scripts/mcp-index.mjs",
    "mcp:page": "node scripts/mcp-index-page.mjs",
    "receipts": "node scripts/receipts.mjs",
    "receipts:page": "node scripts/receipts-page.mjs"
  },
  "dependencies": {
    "fast-glob": "3.3.2",
    "gpt-tokenizer": "3.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naeha-S/ctxcap.git"
  },
  "bugs": {
    "url": "https://github.com/Naeha-S/ctxcap/issues"
  },
  "homepage": "https://github.com/Naeha-S/ctxcap#readme",
  "author": "Naeha S",
  "keywords": [
    "claude-code",
    "cursor",
    "agents",
    "context",
    "ctxcap",
    "token-budget",
    "context-engineering",
    "prompt-engineering",
    "linter",
    "mcp",
    "sarif",
    "github-action"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "ajv": "^8.20.0",
    "yaml": "^2.9.1"
  }
}
