{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ctxcap@1.6.0 hook post-edit",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y ctxcap@1.6.0 hook stop",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "_ctxcap": {
    "version": "1.6.0"
  }
}
