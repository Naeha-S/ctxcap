{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Naeha-S/ctxcap/schema/badge.schema.json",
  "title": "shields.io endpoint badge",
  "description": "The response shields.io accepts from an endpoint badge URL, transcribed from endpointSchema in badges/shields services/endpoint-common.js. Unknown keys are rejected there too.",
  "type": "object",
  "required": ["schemaVersion", "label", "message"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "label": { "type": "string" },
    "message": { "type": "string", "minLength": 1 },
    "color": { "type": "string", "minLength": 1 },
    "labelColor": { "type": "string", "minLength": 1 },
    "isError": { "type": "boolean" },
    "namedLogo": { "type": "string", "minLength": 1 },
    "logoSvg": { "type": "string", "minLength": 1 },
    "logoColor": { "type": "string", "minLength": 1 },
    "logoSize": { "type": "string", "minLength": 1 },
    "style": { "type": "string", "minLength": 1 },
    "cacheSeconds": { "type": "integer", "minimum": 0 }
  },
  "not": { "required": ["namedLogo", "logoSvg"] },
  "dependencies": { "logoColor": ["namedLogo"], "logoSize": ["namedLogo"] }
}
